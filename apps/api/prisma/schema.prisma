generator client {
  provider = "prisma-client-js"
}

// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.svg"
// }

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WeekType {
  ODD
  EVEN
  EVERY
}

enum GradeAuditAction {
  CREATED
  UPDATED
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  role                 Role                  @default(ADMIN)
  isSuperAdmin         Boolean               @default(false)
  teacher              Teacher?
  student              Student?
  parent               Parent?
  refreshTokenSessions RefreshTokenSession[]
  notifications        Notification[]
}

model RefreshTokenSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Teacher {
  id        Int    @id @default(autoincrement())
  userId    Int    @unique
  firstName String
  lastName  String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessons        Lesson[]
  scheduleSlots  ScheduleSlot[]
  classes        TeacherClass[]
  subjects       TeacherSubject[]
  gradeAuditLogs GradeAuditLog[]
}

model Student {
  id        Int    @id @default(autoincrement())
  userId    Int    @unique
  classId   Int
  firstName String
  lastName  String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id])

  grades         Grade[]
  attendances    Attendance[]
  parents        ParentStudent[]
  gradeAuditLogs GradeAuditLog[]
}

model Parent {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]

  @@index([userId])
}

model ParentStudent {
  parentId  Int
  studentId Int

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String
  students      Student[]
  lessons       Lesson[]
  scheduleSlots ScheduleSlot[]
  teachers      TeacherClass[]
}

model Subject {
  id            Int              @id @default(autoincrement())
  name          String // "Mathematics"
  shortName     String? // "Math"
  lessons       Lesson[]
  scheduleSlots ScheduleSlot[]
  teachers      TeacherSubject[]
}

model TeacherClass {
  teacherId Int
  classId   Int

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@index([classId])
}

model TeacherSubject {
  teacherId Int
  subjectId Int

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model Classroom {
  id       Int     @id @default(autoincrement())
  number   String
  building String?
  capacity Int?

  lessons       Lesson[]
  scheduleSlots ScheduleSlot[]

  @@unique([number, building])
}

model ScheduleSlot {
  id          Int       @id @default(autoincrement())
  classId     Int
  subjectId   Int
  teacherId   Int
  classroomId Int
  dayOfWeek   DayOfWeek
  startTime   DateTime
  endTime     DateTime
  weekType    WeekType  @default(EVERY)

  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id])
  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  classroom     Classroom      @relation(fields: [classroomId], references: [id])
  lessons       Lesson[]
  notifications Notification[]

  @@unique([classId, dayOfWeek, startTime, weekType])
  @@unique([teacherId, dayOfWeek, startTime, weekType])
  @@unique([classroomId, dayOfWeek, startTime, weekType])
  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([classroomId, dayOfWeek])
}

model Lesson {
  id             Int             @id @default(autoincrement())
  teacherId      Int
  classId        Int
  subjectId      Int
  classroomId    Int?
  scheduleSlotId Int?
  date           DateTime
  topic          String
  homework       String?
  teacher        Teacher         @relation(fields: [teacherId], references: [id])
  class          Class           @relation(fields: [classId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  classroom      Classroom?      @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  scheduleSlot   ScheduleSlot?   @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  grades         Grade[]
  attendances    Attendance[]
  gradeAuditLogs GradeAuditLog[]
  notifications  Notification[]

  @@unique([scheduleSlotId, date])
  @@index([classroomId])
  @@index([scheduleSlotId])
}

model Grade {
  id            Int             @id @default(autoincrement())
  lessonId      Int
  studentId     Int
  value         Int
  comment       String?
  lesson        Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  auditLogs     GradeAuditLog[]
  notifications Notification[]

  @@unique([lessonId, studentId])
}

model GradeAuditLog {
  id         Int              @id @default(autoincrement())
  gradeId    Int
  lessonId   Int
  studentId  Int
  teacherId  Int?
  action     GradeAuditAction
  oldValue   Int?
  newValue   Int
  oldComment String?
  newComment String?
  createdAt  DateTime         @default(now())

  grade   Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([gradeId])
  @@index([lessonId])
  @@index([studentId])
  @@index([teacherId])
  @@index([createdAt])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  studentId Int
  isPresent Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
}

// `User`, `Teacher`, `Student`, `Class`, `Subject`

enum NotificationType {
  NEW_GRADE
  GRADE_UPDATED
  HOMEWORK_UPDATED
  SCHEDULE_CHANGED
}

model Notification {
  id             Int              @id @default(autoincrement())
  userId         Int
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  gradeId        Int?
  lessonId       Int?
  scheduleSlotId Int?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade        Grade?        @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  lesson       Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  scheduleSlot ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
